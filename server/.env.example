HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
# 注意：本文件是本机开发模板。PUBLIC_BASE_URL 为 localhost 时，学校生产 CAS 不会也不应
# 接受它作为 service；本机不能直接完成真实学校实名校验。真实联调请使用信息中心登记的
# 测试 HTTPS API 域名，并把 PUBLIC_BASE_URL 改成该域名。
# 仅当 API 位于受控反向代理后，且代理会覆盖外部 X-Forwarded-* 头时设为 true。
TRUST_PROXY=false
# 使用宝塔/Nginx反代时启用，并仅填写实际反代来源的IP/CIDR；不可填写全网段。
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# 可选离线IP归属库目录，默认 DATA_FILE 同级 ip-region；不向外部服务发送用户IP。
AUDIT_GEO_DIR=
# 私有聊天附件总配额：默认20GiB，单文件上限5GiB，未发送任务24小时过期
CHAT_STORAGE_LIMIT_BYTES=21474836480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4180,http://127.0.0.1:4180
# 仅登记新用户注册实名校验的客户端回跳地址；管理后台不参与学校校验回跳。
RETURN_URL_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CAS/OIDC 只用于新用户注册时跳转学校官网完成实名校验，不作为湖财人日常登录方式，
# 也不会在学校回调阶段创建账号或签发湖财人 accessToken。
# auto：配置了 OIDC_CLIENT_ID 就优先 OIDC，否则使用 CAS。小程序正式接入推荐 OIDC。
SSO_PROTOCOL=auto
# 默认从后台“学校实名校验配置”保存并启用；未启用时后台和人工认证仍可运行。
# 只有明确继续使用旧环境变量管理方式时才设为 false。
SSO_MANAGED_IN_ADMIN=true
# 学校地址精确域名许可清单，不能在后台自行扩大；多个域名使用逗号分隔。
SCHOOL_AUTH_ALLOWED_HOSTS=uia.hufe.edu.cn

# 示例故意使用不可解析的 .invalid 域名，防止本地开发误连学校生产认证。
# 测试联调时替换成信息中心分配的测试端点；生产值另存于生产密钥系统，不复制本文件。
CAS_BASE_URL=https://replace-with-school-test-auth.example.invalid/cas
CAS_LOGIN_PATH=/login
CAS_VALIDATE_PATH=/serviceValidate
# 必须填写信息中心已经在 CAS 服务端精确登记的公网 HTTPS 回调地址，且须与 PUBLIC_BASE_URL 同源；
# 系统按原值传给 CAS，注册事务由 Secure/HttpOnly 临时 Cookie 关联。禁止 localhost、内网 IP 或 HTTP。
CAS_SERVICE_URL=https://YOUR-PUBLIC-API-DOMAIN/api/v1/auth/registration/callback
CAS_REQUEST_TIMEOUT_MS=8000

OIDC_ISSUER=https://replace-with-school-test-auth.example.invalid/cas
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email phone
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_REQUEST_TIMEOUT_MS=8000

# 按信息中心测试报文的“实际字段名”填写，区分大小写。上线前必须逐项确认姓名、学院/部门、
# 人员类型均非空且值域可识别；不可凭字段名猜测。CAS/OIDC 只用于新注册学校身份校验。
CAS_ATTRIBUTE_NAME=cn
CAS_ATTRIBUTE_STUDENT_ID=studentId
CAS_ATTRIBUTE_ID_CARD=idCard
CAS_ATTRIBUTE_DEPARTMENT=department
CAS_ATTRIBUTE_MAJOR=major
CAS_ATTRIBUTE_CLASS_NAME=className
CAS_ATTRIBUTE_ENROLLMENT_YEAR=enrollmentYear
CAS_ATTRIBUTE_GRADUATION_YEAR=graduationYear
CAS_ATTRIBUTE_EXPECTED_GRADUATION_YEAR=expectedGraduationYear
CAS_ATTRIBUTE_AFFILIATION=affiliation
CAS_ATTRIBUTE_ALUMNI_STATUS=alumniStatus
CAS_ATTRIBUTE_PERSON_TYPE=personType
CAS_ATTRIBUTE_ROLES=roles
CAS_ALUMNI_STATUS_VALUES=alumni,verified,校友,已认证

# 仅在新用户注册实名校验时，按稳定学校 subject 或学校角色授予管理员权限；后续使用平台账号密码登录。
ADMIN_SUBJECTS=
ADMIN_ROLE_VALUES=hufe-alumni-admin,校友平台管理员

# 可选：学校批准的校友库核验接口。服务端以 POST JSON 发送 CAS 身份结果，
# 预期返回 {"verified":true,"alumniNo":"...","profile":{...}}。
ALUMNI_VERIFY_API_URL=
ALUMNI_VERIFY_API_TOKEN=

CONTENT_SYNC_INTERVAL_MS=900000
CONTENT_REQUEST_TIMEOUT_MS=10000
CONTENT_CACHE_FILE=./data/content-cache.json
CONTENT_PAGE_SIZE=12
CONTENT_SYNC_PAGES=2
CONTENT_DETAIL_LIMIT_PER_SOURCE=8
DATA_FILE=./data/application-data.json
DATA_HASH_SECRET=replace-with-a-long-random-secret

# 手动刷新接口 POST /api/v1/admin/content/sync 的请求头 X-Sync-Key。
ADMIN_SYNC_KEY=replace-with-a-long-random-secret
SSO_SESSION_TTL_MS=600000
# 学校官网校验成功后签发的一次性新用户注册凭证有效期；它不能用于登录。
REGISTRATION_TICKET_TTL_MS=600000
ACCESS_TOKEN_TTL_MS=28800000
