# H5 本地开发默认连接本机 API；API 同时提供平台账号登录、新用户注册实名校验和官网同步。
VITE_API_BASE_URL=http://localhost:8787
VITE_API_TIMEOUT=10000
# 本地回调未在学校统一认证登记，必须保持关闭，防止跳转到不可用 CAS 页面。
# 学校校验启用状态由后台配置接口实时返回，此旧构建变量不再控制入口。
VITE_SCHOOL_REGISTRATION_READY=false
# 仅缓存已通过平台 accessToken 从 /me 读取的身份展示，不代表学校官网重新校验。
VITE_IDENTITY_FRESH_TTL_MS=300000

# 后台正文编辑器上传图片的本地开发目录。生产环境建议挂载持久卷并纳入备份。
MEDIA_DIR=./data/media
