{
  "name": "hufe-community-uniapp",
  "version": "0.2.0",
  "private": true,
  "description": "面向湖财学生、教师、职工和校友的 uni-app 多端平台",
  "scripts": {
    "local:start": "node scripts/local-app.mjs start",
    "local:status": "node scripts/local-app.mjs status",
    "local:stop": "node scripts/local-app.mjs stop",
    "build": "node scripts/run-uni.mjs build h5 && node scripts/prepare-sites-build.mjs",
    "dev:h5": "node scripts/run-uni.mjs dev h5",
    "dev:mp-weixin": "node scripts/run-uni.mjs dev mp-weixin",
    "dev:mp-alipay": "node scripts/run-uni.mjs dev mp-alipay",
    "dev:app": "node scripts/run-uni.mjs dev app",
    "build:h5": "node scripts/run-uni.mjs build h5",
    "build:sites": "node scripts/run-uni.mjs build h5 && node scripts/prepare-sites-build.mjs",
    "build:mp-weixin": "node scripts/run-uni.mjs build mp-weixin",
    "build:mp-alipay": "node scripts/run-uni.mjs build mp-alipay",
    "build:app": "node scripts/run-uni.mjs build app",
    "generate:icons": "node scripts/generate-icons.mjs",
    "validate": "node scripts/validate-project.mjs",
    "server:dev": "pnpm --filter @hufe-alumni/server dev",
    "server:start": "pnpm --filter @hufe-alumni/server start",
    "server:sync": "pnpm --filter @hufe-alumni/server sync",
    "server:test": "pnpm --filter @hufe-alumni/server test",
    "admin:dev": "pnpm --filter hufe-unified-platform-admin dev",
    "admin:build": "pnpm --filter hufe-unified-platform-admin build",
    "admin:test": "pnpm --filter hufe-unified-platform-admin test",
    "client:test": "node --test test/*.test.mjs",
    "test": "pnpm validate && pnpm client:test && pnpm admin:test && pnpm admin:build && pnpm server:test"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-app-plus": "3.0.0-5010520260709002",
    "@dcloudio/uni-components": "3.0.0-5010520260709002",
    "@dcloudio/uni-h5": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-alipay": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5010520260709002",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5010520260709002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "@vue/compiler-sfc": "^3.4.21",
    "@vue/runtime-core": "^3.4.21",
    "rollup": "4.14.3",
    "vite": "5.2.8"
  },
  "engines": {
    "node": ">=18"
  }
}
