# 仅为模板。复制到站点目录之外的受保护路径后逐项填写，不能原样启动。
# 此文件按 Node.js 22 --env-file 语法读取；不要写 export，不要提交真实密钥。
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=https://your-domain.invalid
CORS_ORIGINS=https://your-domain.invalid
RETURN_URL_ORIGINS=https://your-domain.invalid

DATABASE_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=REPLACE_WITH_DEDICATED_DATABASE
MYSQL_USER=REPLACE_WITH_APPLICATION_USER
MYSQL_PASSWORD=REPLACE_WITH_PRIVATE_DATABASE_PASSWORD

# 新建无数据环境：由密码管理器生成至少 32 字符的随机密钥。
# 搬迁 / 升级：必须沿用原 DATA_HASH_SECRET，禁止重新生成。
DATA_HASH_SECRET=REPLACE_WITH_EXISTING_OR_NEW_RANDOM_SECRET

# 即使 MySQL 模式不写 application-data.json，DATA_FILE 的父目录仍用于文件存储。
DATA_FILE=/opt/hufe-platform/shared/data/application-data.json
MEDIA_DIR=/opt/hufe-platform/shared/data/media
CONTENT_CACHE_FILE=/opt/hufe-platform/shared/data/content-cache.json
AUDIT_GEO_DIR=/opt/hufe-platform/current/server/ip-region
CHAT_STORAGE_LIMIT_BYTES=21474836480

# 本模板仅适合 Nginx 与 Node 原生进程同机，API 只监听回环地址。
# Docker / 多层代理须按实际拓扑另行填写精确 CIDR，禁止 TRUST_PROXY=true。
TRUST_PROXY=127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# 默认由后台配置、检查并启用学校认证；全新数据库不会自动拥有管理员。
SSO_MANAGED_IN_ADMIN=true
SCHOOL_AUTH_ALLOWED_HOSTS=uia.hufe.edu.cn
SSO_PROTOCOL=cas
CAS_BASE_URL=https://uia.hufe.edu.cn/cas
CAS_LOGIN_PATH=/login
CAS_VALIDATE_PATH=/serviceValidate
CAS_SERVICE_URL=https://your-domain.invalid/api/v1/auth/registration/callback
OIDC_ISSUER=https://uia.hufe.edu.cn/cas
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# 仅按学校正式授权设置；学校 subject 不等于平台用户名。
ADMIN_SUBJECTS=
ADMIN_ROLE_VALUES=REPLACE_WITH_SCHOOL_APPROVED_ADMIN_ROLE
CAS_ATTRIBUTE_NAME=cn
CAS_ATTRIBUTE_DEPARTMENT=department
CAS_ATTRIBUTE_STUDENT_ID=studentId
CAS_ATTRIBUTE_MAJOR=major
CAS_ATTRIBUTE_CLASS_NAME=className
CAS_ATTRIBUTE_ENROLLMENT_YEAR=enrollmentYear
CAS_ATTRIBUTE_GRADUATION_YEAR=graduationYear
CAS_ATTRIBUTE_EXPECTED_GRADUATION_YEAR=expectedGraduationYear
CAS_ATTRIBUTE_ROLES=roles
